# PostgreSQL connection string (Render: use your DB connection string)
DATABASE_URL="postgresql://user:password@localhost:5432/vessify"

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-32+-character-secret"

# Base URL of THIS backend (used by Better Auth for callback/cookie config)
BETTER_AUTH_URL="http://localhost:8787"

# URL of the frontend (used for CORS + trusted origins)
FRONTEND_URL="http://localhost:3000"

PORT=8787
NODE_ENV=development
